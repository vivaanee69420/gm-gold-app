{
  "expo": {
    "name": "GM Referral",
    "slug": "gm-referral",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gmreferral",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B2B26",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B2B26"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uk.co.gmdental.referral",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan a friend's referral QR code."
      }
    },
    "android": {
      "package": "uk.co.gmdental.referral",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0B2B26"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan a friend's referral QR code.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a0378230-eaff-4c01-92b2-8696d71cea1c"
      }
    },
    "owner": "ruhithpasha",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a0378230-eaff-4c01-92b2-8696d71cea1c"
    }
  }
}
