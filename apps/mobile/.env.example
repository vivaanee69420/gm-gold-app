# Mobile build-time config. Anything prefixed EXPO_PUBLIC_ is COMPILED INTO THE APP BINARY
# and is readable by anyone who installs it. Only put public values here.

# The Express API.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Supabase Auth (patient sign-in). Both values are public by design: the anon key is meant to
# ship in clients, and it is not a session — the API pins `audience: 'authenticated'` when it
# verifies tokens precisely so a bearer anon key cannot be used as one.
#
# NEVER put the service_role key here. It bypasses every access rule, and an EXPO_PUBLIC_
# variable ends up inside the APK.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
